rules_version = '2';

// Regras do Cloud Firestore para o Quita+.
// Publicar com:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção de usuários do jogo.
    // - Leitura: qualquer usuário autenticado (o ranking mostra nome, nível e XP de todos).
    // - Escrita: cada usuário só pode escrever no próprio documento.
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == uid;
    }

    // Bloqueia tudo que não foi explicitamente permitido acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
