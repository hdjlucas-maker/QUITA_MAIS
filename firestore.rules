rules_version = '2';

// Regras do Cloud Firestore para o Quita+.
// Publicar com:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Informações financeiras e progresso privado do usuário.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // O ranking publica apenas nome, nível e XP; nunca os dados financeiros.
    match /ranking/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'nivel', 'xpTotal', 'atualizadoEm'])
        && request.resource.data.keys().hasAll(['nome', 'nivel', 'xpTotal', 'atualizadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 30
        && request.resource.data.nivel is int
        && request.resource.data.xpTotal is int
        && request.resource.data.atualizadoEm is string;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Bloqueia tudo que não foi explicitamente permitido acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
